__pycache__/
gym/logs/*
*.pkl
# Exception: the polynomial gait library is a frozen training/eval dataset —
# ImitationReward and gate evaluation depend on this exact artifact
# (see isaac_lab_env/open_duck_mini_v2/data/README.md)
!isaac_lab_env/open_duck_mini_v2/data/polynomial_coefficients.pkl
# v5 grid-completed library (scripts/patch_reference_library.py). Committed for
# the same reason as the original: a fresh clone must be able to train the v5
# task, and the file is a validated artifact, not derivable-on-demand code.
!isaac_lab_env/open_duck_mini_v2/data/polynomial_coefficients_v2.pkl
mini_bdx/mini_bdx.egg-info/*
experiments/RL/data/*
experiments/RL/new/logs/
experiments/RL/new/sac/
experiments/RL/new/ppo/
*.zip

# ART-4: this ignored EVERY .txt repo-wide, which silently swallowed evidence
# files (the S.8 bench notes had to be renamed to .md to survive). Narrowed to
# the training scratch that actually needs ignoring.
experiments/**/*.txt
logs/**/*.txt

# ART-1: this ignored the exported graph while its weight sidecar
# (policy.onnx.data, 774 KB) WAS tracked, so a fresh clone got an orphan sidecar
# and onnxruntime failed with a confusing external-data error. The exported
# policy is the deliverable -- jetson_runtime/policy.py loads it -- so it must
# survive a clean checkout.
*.onnx
!exported_policies/**/*.onnx
.training_runs/
